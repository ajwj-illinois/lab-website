---
import Base from '../layouts/Base.astro';
import ResearchCard from '../components/ResearchCard.astro';
import PersonCard from '../components/PersonCard.astro';
import PubList from '../components/PubList.astro';
import NewsCard from '../components/NewsCard.astro';
import { render } from 'astro:content';
import site from '../data/site.json';
import { getResearch, getPeople, getNews, getSelectedPubs } from '../lib/content';

const research = await getResearch();
const { pi, current } = await getPeople();
const news = (await getNews()).slice(0, 3);
const pubs = getSelectedPubs(5);
const PiBio = pi ? (await render(pi)).Content : null;
---
<Base>
  <section class="hero">
    <svg class="fibers" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs><linearGradient id="g" x1="0" x2="1"><stop offset="0" stop-color="#FF5F05" stop-opacity="0"/><stop offset=".6" stop-color="#FF5F05" stop-opacity=".55"/><stop offset="1" stop-color="#1D58A7" stop-opacity=".8"/></linearGradient></defs>
      <g fill="none" stroke="url(#g)" stroke-width="1.4">
        {Array.from({ length: 8 }, (_, i) => <path d={`M${500 + i * 40} 620 C${650 + i * 35} ${420 + i * 18} ${760 + i * 30} ${330 + i * 20} 1220 ${250 + i * 30}`} />)}
        {Array.from({ length: 4 }, (_, i) => <path d={`M${700 + i * 40} -20 C${800 + i * 35} ${120 - i * 10} ${900 + i * 30} ${180 - i * 20} 1220 ${190 - i * 30}`} />)}
      </g>
    </svg>
    <div class="wrap">
      <div class="eyebrow">{site.lab_full_name}</div>
      <h1>{site.hero_headline}</h1>
      <p>{site.hero_intro}</p>
      <div class="btns">
        <a class="btn primary" href="#research">Explore our research</a>
        <a class="btn ghost" href="/join/">Join the lab</a>
      </div>
    </div>
  </section>

  <section class="block" id="research">
    <div class="wrap">
      <div class="sec-head">
        <div><div class="eyebrow">Research</div><h2>{site.research_heading}</h2></div>
        <p>{site.research_intro}</p>
      </div>
      <div class="themes">{research.map((r) => <ResearchCard entry={r} />)}</div>
    </div>
  </section>

  <section class="block tint">
    <div class="wrap">
      <div class="sec-head"><div><div class="eyebrow">Approach</div><h2>How we measure</h2></div></div>
      <div class="methods">{site.methods.map((m) => <div class="method"><b>{m.name}</b><span>{m.description}</span></div>)}</div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="sec-head">
        <div><div class="eyebrow">People</div><h2>The team</h2></div>
        <a class="more" href="/people/">Everyone, including alumni →</a>
      </div>
      {pi && (
        <div class="pi">
          <div class="portrait">{pi.data.photo ? <img src={pi.data.photo} alt={`Portrait of ${pi.data.name}`} /> : 'Portrait photo'}</div>
          <div>
            <h3>{pi.data.name}</h3>
            <div class="role">{pi.data.program}</div>
            <div class="bio">{PiBio && <PiBio />}</div>
            <ul>
              {pi.data.highlights.map((h) => <li>{h}</li>)}
              <li>
                {pi.data.email && <a href={`mailto:${pi.data.email}`}>{pi.data.email}</a>}
                {pi.data.scholar && <> · <a href={pi.data.scholar}>Google Scholar</a></>}
                {pi.data.cv && <> · <a href={pi.data.cv}>CV</a></>}
              </li>
            </ul>
          </div>
        </div>
      )}
      <div class="people" style="margin-top:56px">{current.slice(0, 8).map((p) => <PersonCard entry={p} />)}</div>
    </div>
  </section>

  <section class="block tint">
    <div class="wrap">
      <div class="sec-head">
        <div><div class="eyebrow">Publications</div><h2>Selected work</h2></div>
        <a class="more" href="/publications/">All publications →</a>
      </div>
      <PubList pubs={pubs} />
    </div>
  </section>

  {news.length > 0 && (
    <section class="block">
      <div class="wrap">
        <div class="sec-head">
          <div><div class="eyebrow">News</div><h2>Lately</h2></div>
          <a class="more" href="/news/">All news →</a>
        </div>
        <div class="news-grid">{news.map((n) => <NewsCard entry={n} />)}</div>
      </div>
    </section>
  )}

  <section class="join">
    <div class="wrap">
      <div><h2>{site.join_heading}</h2><p>{site.join_text}</p></div>
      <div class="btns"><a class="btn dark" href="/join/">How to join</a></div>
    </div>
  </section>
</Base>
