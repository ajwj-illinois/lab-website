---
import Icon from './Icon.astro';
import type { CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'research'>; }
const { entry } = Astro.props;
const d = entry.data;
---
{d.featured ? (
  <a class="theme featured" href={`/research/${entry.id}/`}>
    <div>
      <div class="eyebrow">Flagship area</div>
      <h3>{d.title}</h3>
      <p>{d.summary}</p>
      <div class="tags">{d.tags.map((t) => <span class="tag">{t}</span>)}</div>
    </div>
    <div class="featured-visual">
      {d.image ? <img src={d.image} alt={d.image_caption || ''} loading="lazy" /> : (
        <svg viewBox="0 0 400 260" width="100%" height="100%" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <g fill="none" stroke="#FF5F05" stroke-opacity=".75" stroke-width="1.2">
            <ellipse cx="200" cy="130" rx="150" ry="95"/><ellipse cx="200" cy="130" rx="128" ry="80"/>
            <ellipse cx="200" cy="130" rx="106" ry="65"/><ellipse cx="200" cy="130" rx="84" ry="50"/>
          </g>
          <g fill="none" stroke="#9fb6d9" stroke-opacity=".6" stroke-width="1">
            <ellipse cx="200" cy="130" rx="62" ry="36"/><ellipse cx="200" cy="130" rx="40" ry="22"/>
          </g>
          <text x="20" y="245" fill="#9fb6d9" font-family="Montserrat, sans-serif" font-size="11" letter-spacing="1.5">ADD AN SHG IMAGE IN THE EDITOR</text>
        </svg>
      )}
    </div>
  </a>
) : (
  <a class="theme" href={`/research/${entry.id}/`}>
    <Icon name={d.icon} />
    <h3>{d.title}</h3>
    <p>{d.summary}</p>
    <div class="tags">{d.tags.map((t) => <span class="tag">{t}</span>)}</div>
  </a>
)}
