---
// Small line icons for research themes. Choose one per theme in the editor.
interface Props { name: string; class?: string }
const { name, class: cls = 'ico' } = Astro.props;
---
<svg class={cls} viewBox="0 0 48 48" aria-hidden="true" fill="none" stroke-width="2.5" stroke-linecap="round">
  {name === 'cervix' && (<>
    <ellipse cx="24" cy="24" rx="20" ry="14" stroke="var(--blue)"/><ellipse cx="24" cy="24" rx="13" ry="8.5" stroke="var(--orange)"/><ellipse cx="24" cy="24" rx="6" ry="3.5" stroke="var(--blue)"/>
  </>)}
  {name === 'inflammation' && (<>
    <circle cx="24" cy="24" r="20" stroke="var(--blue)"/><path d="M10 28c6-8 10 4 14-4s8 4 14-4" stroke="var(--orange)"/>
  </>)}
  {name === 'scaffold' && (<>
    <rect x="6" y="6" width="36" height="36" stroke="var(--blue)"/>
    <g fill="var(--orange)" stroke="none"><circle cx="16" cy="16" r="4"/><circle cx="32" cy="16" r="4"/><circle cx="16" cy="32" r="4"/><circle cx="32" cy="32" r="4"/><circle cx="24" cy="24" r="4"/></g>
  </>)}
  {name === 'coral' && (<>
    <path d="M24 42V20M24 26l-10-10M24 22l9-9M14 16l-4-6M14 16l-7 1M33 13l2-7M33 13l7 1" stroke="var(--blue)"/><circle cx="24" cy="42" r="3" fill="var(--orange)" stroke="none"/>
  </>)}
  {name === 'tendon' && (<>
    <path d="M6 14c12 0 24 20 36 20" stroke="var(--blue)"/><path d="M6 24h36" stroke="var(--orange)"/><path d="M6 34c12 0 24-20 36-20" stroke="var(--blue)"/>
  </>)}
  {name === 'imaging' && (<>
    <circle cx="20" cy="20" r="13" stroke="var(--blue)"/><path d="M30 30l12 12" stroke="var(--orange)"/><path d="M13 20c3-4 5 4 7 0s4 4 7 0" stroke="var(--orange)"/>
  </>)}
</svg>
