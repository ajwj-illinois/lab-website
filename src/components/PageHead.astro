---
interface Props { eyebrow: string; title: string; intro?: string }
const { eyebrow, title, intro } = Astro.props;
---
<section class="pagehead">
  <svg class="fibers" viewBox="0 0 1200 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs><linearGradient id="pg" x1="0" x2="1"><stop offset="0" stop-color="#FF5F05" stop-opacity="0"/><stop offset=".7" stop-color="#FF5F05" stop-opacity=".5"/><stop offset="1" stop-color="#1D58A7" stop-opacity=".8"/></linearGradient></defs>
    <g fill="none" stroke="url(#pg)" stroke-width="1.3">
      {Array.from({ length: 9 }, (_, i) => <path d={`M${600 + i * 40} 320 C${740 + i * 30} ${220 + i * 8} ${860 + i * 25} ${170 + i * 6} 1220 ${110 + i * 22}`} />)}
    </g>
  </svg>
  <div class="wrap">
    <div class="eyebrow">{eyebrow}</div>
    <h1>{title}</h1>
    {intro && <p>{intro}</p>}
  </div>
</section>
